{
  "mcpServers": {
    "playwright": {
      "command": "${workspaceFolder}/.cuttle_global/scripts/playwright-mcp.cmd",
      "args": []
    },
    "govee": {
      "command": "node",
      "args": [
        "${workspaceFolder}/vendor/mcp-govee/dist/index.js"
      ],
      "envFile": "${workspaceFolder}/src/.env"
    },
    "comfyui": {
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/src/tools/comfyui/comfyui_mcp.py"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "COMFYUI_ROOT": "F:\\AI\\ComfyUI-Trellis",
        "COMFYUI_URL": "http://127.0.0.1:8188"
      }
    }
  }
}
