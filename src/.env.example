# Cuttle environment template — keys are grouped by significance.
# Copy to src/.env and fill in only what you need. Never commit a real .env.
# A Flask/daemon restart is required after changing this file.

# === 1. Identity & owner (who admins this host) ===
# The ONE account (email or username, case-insensitive) that owns admin
# mutations: git commit/push, project CRUD, settings, restart.
# Guests are never owners. Leave blank for single-user mode, where every
# non-guest signed-in account is an owner.
OWNER_USER_EMAIL=

# === 2. Sign-in providers (optional OAuth) ===
# Browser host for OAuth callbacks. Prefer OAUTH_REDIRECT_BASE when the
# browser reaches Flask on a different host than CUTTLE_API_URL.
# CUTTLE_API_URL=https://127.0.0.1:8080
# OAUTH_REDIRECT_BASE=https://localhost:8080
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# === 3. Optional provider keys (direct LLM, routing brain, vision) ===
# Vendor CLIs authenticate separately: codex login, Cursor CLI login, or Claude
# account/API-key login. These keys do not authenticate every cloud harness.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Local LLM (Ollama by default; llamacpp launches on demand):
# LOCAL_LLM_BACKEND=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLAMACPP_BASE_URL=http://127.0.0.1:8081
# LLAMACPP_MODEL=

# === 4. Device mesh & farm workers ===
# Host side: leave ENABLED on (default) to accept workers.
# CUTTLE_DEVICE_WORKERS_ENABLED=1
# Legacy shared worker Bearer [REDACTED] Prefer auto-enroll per device.
# CUTTLE_DEVICE_WORKERS_TOKEN=
# CUTTLE_DEVICE_WORKERS_POLL_SECONDS=
# Worker side (set on the remote machine, pointing at its host):
# CUTTLE_DEVICE_WORKERS_COORDINATOR_URL=https://<host>:8080
# CUTTLE_DEVICE_WORKER_ID=
# CUTTLE_DEVICE_WORKER_INTERACTIVE=

# === 5. Integrations (all optional) ===
# Discord agent-ops: REST read/post only, does NOT start an inbound gateway.
DISCORD_TOKEN=
