# Cuttle environment template
# Copy to src/.env (or repo-root .env) and fill in values you need.
# Never commit a real .env — it is gitignored.

# --- Discord agent-ops (optional; does NOT start an inbound gateway) ---
# Used only by python -m api.discord_cli and confirmed discord.post REST calls.
DISCORD_TOKEN=
OWNER_ID=
OWNER_USER_EMAIL=

# --- LLM providers (at least one for cloud agents / vision) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional alias some older scripts still check:
# CLAUDE_API_KEY=

# --- Behavior ---
BOT_PREFIX=!
DEBUG_MODE=false
LOG_LEVEL=INFO
TEST_MODE=false
SAFE_MODE=false

# --- Public API / OAuth redirects (Flask is HTTPS on :8080) ---
# CUTTLE_API_URL=https://127.0.0.1:8080
# Optional override if the browser host differs from CUTTLE_API_URL:
# OAUTH_REDIRECT_BASE=https://localhost:8080
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# --- WSL (optional; Claude Code / Linux tools) ---
# WSL_USER=
# WSL_HOME=

# --- Voice (optional) ---
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=

# --- Home automation (optional; omit for a clean public install) ---
# GOVEE_API_KEY=

# --- Local LLM ---
# LOCAL_LLM_BACKEND=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLAMACPP_BASE_URL=http://127.0.0.1:8081
# LLAMACPP_MODEL=

# --- Home automation (optional; not part of OOBE) ---
# GOVEE_API_KEY=
# Future Nest / Google SDM (stub provider until implemented):
# NEST_CLIENT_ID=
# NEST_CLIENT_SECRET=
# NEST_PROJECT_ID=

# --- Gitea (optional LAN forge) ---
# GITEA_BASE_URL=http://127.0.0.1:3000
# GITEA_TOKEN=
# GITEA_AGENT_USERNAME=cuttle
# GITEA_COMMIT_AUTHOR_EMAIL=cuttle@localhost

# --- Cuttle Jobs (Gitea @cuttle → queue → this daemon) ---
# CUTTLE_JOBS_ENABLED=1
# CUTTLE_JOBS_BASE_URL=http://127.0.0.1:8091
# CUTTLE_JOBS_WORKER_TOKEN=
# CUTTLE_JOBS_POLL_SECONDS=15
# CUTTLE_JOBS_WORKSPACES=owner/repo=/path/to/workspace
# CUTTLE_JOBS_AGENT=cursor
# CUTTLE_JOBS_AGENT_TIMEOUT=3600
