# Environment variables (contains sensitive tokens)
.env
src/.env
!.env.example
!src/.env.example

# Personal / home-lab dogfood (keep locally; omit from public trees)
_personal/
.vapi_cuttle_assistant_id

# Local home-automation device inventory (MAC / device ids)
src/data/home_automation_devices.json
!src/data/home_automation_devices.example.json

# Local/generated JSON — keep source-of-truth configs tracked via negations below.
# NOTE: bare `*.json` matches at every depth, so every new source-of-truth
# *.json must get a `!` negation here or it will be silently ignored.
*.json
!.cuttle/scripts/git-hooks/scanner-exceptions.json
!electron/package.json
!electron/package-lock.json
!apps/mobile/**/*.json
!src/pipelines/*.json
!src/api/agent_router/suites/*.json

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/
src/.pytest_cache/

# Virtual environment
.venv/
.venv.bak*/
venv/
env/
.venv_wsl/

# Output directory
output/
src/output/

# Cache directory
cache/
src/cache/

# Temporary files
temp_*
*.tmp
*.log
logs/
cuttle_notify_queue.jsonl
cuttle_ui_toasts.jsonl
cuttle_flask_restart_status.json
cuttle_flask_restart_request.json
cuttle_flask_restart_status.json.tmp
cuttle_flask_restart_request.json.tmp

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Secret files live in .cuttle/personal/secrets/ (covered by .cuttle/personal/).
# Retired secret locations stay ignored so older checkouts never commit them.
.secret_DONOTSHIP/
src/data/certs/
.cuttle/certs/

# Install-local Cuttle overlay (machine paths, LAN hosts, guild notes) — never ship
.cuttle/personal/*
!.cuttle/personal/README.md
.cuttle/hub/personal/*
!.cuttle/hub/personal/README.md

# Hub config lives at repo-root `.cuttle/` — ignore accidental scaffold under src/
src/.cuttle/

# Workspace data (user/session data — never commit)
src/data/workspace/

# Local runtime DBs
*.db
*.db-journal
*.db-wal
*.db-shm
src/data/db/action_hmac_secret

# Local agent memory / chroma indexes
src/data/agent_memory/

# Transient Govee API serialization lock (Cuttle home automation)
src/data/govee_api_batch.lock

# Playwright browser profiles (contain cookies/session data — never commit)
.playwright-*/
**/.playwright-cuttle-profile/
*.playwright-secrets
playwright-chat-test*.txt

# Electron CDP debug profiles (Chromium user-data — Local Storage, cookies, etc.)
.tmp_electron_cdp_profile/
.tmp_electron_*/
electron/.cdp-profile*/
**/.cdp-profile*/

# Scratch / probe artifacts
.scratch/
_tmp/
helloworld.md
src/scripts/_tmp_*

# Local Claude Code settings
.claude/settings.local.json

# Node modules
node_modules/

# Electron build output
electron/dist/
electron/out/

# Cuttle install-local overlay
.cuttle/personal/

# Cuttle agent scratch
/temp/

# Generated YouTube/promo renders (rebuild via src/scripts/utilities/promo_video.py)
docs/media/promo/

# Marketing scratch (launch copy, storyboards; not product docs)
docs/marketing/


# Local debug dumps / Playwright screenshots (never product assets)
/src/desktop.png
/src/region.png
/src/test_ws_copy.png
/src/verify_nav_history.png
/src/output.txt

# Global install-local overlay (paths, LAN hosts, private project notes)
/.cuttle_global/personal/*
!/.cuttle_global/personal/README.md

# Muse agent run transcripts (local runtime data)
/work/muse-runs/

# Retired shared mesh key directories; identities belong in ~/.ssh
/.cuttle_global/keys/
/.cuttle/keys/

# Owned install-local runtime state (legacy paths above remain ignored).
src/data/sessions/
src/data/brain/
src/data/cache/
src/data/supervised_tasks/
src/data/edit_attribution/
src/data/archive/
src/data/harness_agents/
src/data/home_automation/*
!src/data/home_automation/devices.example.json
!src/data/home_automation/README.md

# Developer test artifacts live with tests, never with production scripts.
src/tests/results/
src/tests/test-results/
src/test-results/
src/scripts/output/
src/data/config/

# Settings atomic-write scratch and stable process lock (install-local).
src/settings.json.lock
src/.settings.json.*
